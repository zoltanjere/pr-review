{
  "model": "claude-sonnet-5.5",
  "azureDevOpsOrg": "https://dev.azure.com/your-organization",
  "defaultRepository": "your-org/your-repo",
  "watch": {
    "events": [
      "new",
      "fixes-after-changes",
      "reviewed-updated",
      "merged-reviewed",
      "merged",
      "review-requested",
      "my-pr-reviewed",
      "my-pr-conflicts"
    ],
    "intervalMinutes": 5
  }
}
